load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

go_library(
    name = "esphome_lib",
    srcs = [
        "bridge.go",
        "devices.go",
        "main.go",
        "node.go",
    ],
    importpath = "github.com/rmrobinson/house/bridges/esphome",
    visibility = ["//visibility:private"],
    deps = [
        "//api",
        "//api/command",
        "//api/device",
        "//api/trait",
        "//service/bridge",
        "@com_github_google_uuid//:uuid",
        "@com_github_richard87_esphome_apiclient//:esphome-apiclient",
        "@com_github_richard87_esphome_apiclient//pb",
        "@com_github_spf13_viper//:viper",
        "@org_golang_google_grpc//codes",
        "@org_golang_google_grpc//status",
        "@org_golang_google_protobuf//proto",
        "@org_golang_google_protobuf//types/known/timestamppb",
        "@org_uber_go_zap//:zap",
    ],
)

go_binary(
    name = "esphome",
    embed = [":esphome_lib"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "esphome_test",
    srcs = [
        "devices_test.go",
        "fakenode_test.go",
        "node_test.go",
    ],
    embed = [":esphome_lib"],
    deps = [
        "//api",
        "//api/command",
        "//api/device",
        "//api/trait",
        "//service/bridge",
        "@com_github_richard87_esphome_apiclient//:esphome-apiclient",
        "@com_github_richard87_esphome_apiclient//pb",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
        "@org_golang_google_grpc//codes",
        "@org_golang_google_grpc//status",
        "@org_golang_google_protobuf//proto",
        "@org_uber_go_zap//zaptest",
    ],
)
