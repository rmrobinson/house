load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

go_library(
    name = "cast_lib",
    srcs = [
        "art.go",
        "bridge.go",
        "command.go",
        "devices.go",
        "discover.go",
        "main.go",
        "version.go",
    ],
    importpath = "github.com/rmrobinson/house/bridges/cast",
    visibility = ["//visibility:public"],
    deps = [
        "//api",
        "//api/command",
        "//api/device",
        "//api/trait",
        "//bridges/lib/castctrl",
        "//service/bridge",
        "@com_github_google_uuid//:uuid",
        "@com_github_hashicorp_mdns//:mdns",
        "@com_github_spf13_viper//:viper",
        "@org_golang_google_grpc//codes",
        "@org_golang_google_grpc//status",
        "@org_golang_google_protobuf//proto",
        "@org_golang_google_protobuf//types/known/timestamppb",
        "@org_uber_go_zap//:zap",
    ],
)

go_test(
    name = "cast_test",
    srcs = [
        "art_test.go",
        "command_test.go",
        "devices_test.go",
        "discover_test.go",
        "version_test.go",
    ],
    embed = [":cast_lib"],
    deps = [
        "//api/command",
        "//api/device",
        "//api/trait",
        "//bridges/lib/castctrl",
        "@com_github_hashicorp_mdns//:mdns",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
        "@org_golang_google_grpc//codes",
        "@org_golang_google_grpc//status",
        "@org_golang_google_protobuf//proto",
        "@org_uber_go_zap//zaptest",
    ],
)

go_binary(
    name = "cast",
    embed = [":cast_lib"],
    visibility = ["//visibility:public"],
)
