load("@rules_go//go:def.bzl", "go_library")
load("@rules_go//proto:def.bzl", "go_proto_library")
load("@rules_proto//proto:defs.bzl", "proto_library")

#gazelle:exclude empty.go

proto_library(
    name = "command_proto",
    srcs = [
        "app.proto",
        "brightness.proto",
        "channel.proto",
        "colour.proto",
        "command.proto",
        "media.proto",
        "mode.proto",
        "movement.proto",
        "onoff.proto",
        "position.proto",
        "speed.proto",
        "thermostat.proto",
        "time.proto",
        "timer.proto",
        "toggle.proto",
        "ventilation.proto",
        "volume.proto",
    ],
    visibility = ["//visibility:public"],
    deps = ["//api/trait:trait_proto"],
)

go_proto_library(
    name = "command_go_proto",
    importpath = "github.com/rmrobinson/house/api/command",
    proto = ":command_proto",
    visibility = ["//visibility:public"],
    deps = ["//api/trait"],
)

go_library(
    name = "command",
    embed = [":command_go_proto"],
    importpath = "github.com/rmrobinson/house/api/command",
    visibility = ["//visibility:public"],
)
