# Raspberry Pi 1 / ARMv6 cross-compilation (GOARM=6, pure Go / no CGO).
# Use: bazel build --config=rpi1 //bridges/monop-amp
# Targets requiring CGO (housed, airthings) won't cross-compile without a C
# arm-linux-gnueabi toolchain configured.
build:rpi1 --platforms=//platforms:linux_arm6
build:rpi1 --@rules_go//go/config:pure=true

# CI: use with `bazel test --config=ci //...`
common:ci --color=no
common:ci --curses=no
build:ci --verbose_failures
test:ci --keep_going
test:ci --test_output=errors
