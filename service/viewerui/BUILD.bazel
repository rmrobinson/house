load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

go_library(
    name = "viewerui_lib",
    srcs = [
        "handlers.go",
        "main.go",
        "metrics.go",
        "overview.go",
        "overview_metrics.go",
        "overview_trends.go",
        "server.go",
        "sse.go",
        "templates.go",
        "view.go",
        "weather.go",
    ],
    embedsrcs = [
        "templates/building.html",
        "templates/buildings.html",
        "templates/layout.html",
        "templates/overview.html",
        "templates/partials/camera.html",
        "templates/partials/device_row.html",
        "templates/partials/floor_panel.html",
        "templates/partials/overview.html",
        "templates/partials/room_detail.html",
        "templates/partials/room_update.html",
        "templates/partials/sparklines.html",
    ],
    importpath = "github.com/rmrobinson/house/service/viewerui",
    visibility = ["//visibility:private"],
    deps = [
        "//api",
        "//api/command",
        "//api/device",
        "//api/trait",
        "//api/weather/v1:weather",
        "//service/lib/configutil",
        "//service/lib/grpcutil",
        "//service/lib/houseview",
        "//service/lib/htmxutil",
        "//service/lib/hub",
        "//service/lib/webassets",
        "@com_github_spf13_viper//:viper",
        "@org_golang_google_grpc//:grpc",
        "@org_golang_google_grpc//metadata",
        "@org_golang_google_protobuf//reflect/protoreflect",
        "@org_golang_google_protobuf//types/known/timestamppb",
        "@org_uber_go_zap//:zap",
    ],
)

go_binary(
    name = "viewerui",
    embed = [":viewerui_lib"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "viewerui_test",
    srcs = [
        "metrics_test.go",
        "overview_trends_test.go",
        "server_test.go",
    ],
    embed = [":viewerui_lib"],
    deps = [
        "//api",
        "//api/command",
        "//api/device",
        "//api/trait",
        "//api/weather/v1:weather",
        "//service/lib/grpcutil",
        "//service/lib/houseview",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
        "@org_golang_google_grpc//:grpc",
        "@org_golang_google_grpc//codes",
        "@org_golang_google_grpc//status",
        "@org_golang_google_protobuf//proto",
        "@org_golang_google_protobuf//types/known/timestamppb",
        "@org_uber_go_zap//zaptest",
    ],
)
