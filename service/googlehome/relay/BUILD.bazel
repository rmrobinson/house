load("@rules_go//go:def.bzl", "go_library")
load("@rules_go//proto:def.bzl", "go_proto_library")
load("@rules_proto//proto:defs.bzl", "proto_library")

proto_library(
    name = "relay_proto",
    srcs = ["googlehome.proto"],
    visibility = ["//visibility:public"],
)

go_proto_library(
    name = "relay_go_proto",
    compilers = ["@rules_go//proto:go_grpc"],  #keep
    importpath = "github.com/rmrobinson/house/service/googlehome/relay",
    proto = ":relay_proto",
    visibility = ["//visibility:public"],
)

go_library(
    name = "relay",
    srcs = [
        "api.go",
        "provider_service.go",
        "remote_provider.go",
    ],
    embed = [":relay_go_proto"],
    importpath = "github.com/rmrobinson/house/service/googlehome/relay",
    visibility = ["//visibility:public"],
    deps = [
        "@com_github_google_uuid//:uuid",
        "@com_github_rmrobinson_google_smart_home_action_go//:google-smart-home-action-go",
        "@org_golang_google_grpc//codes",
        "@org_golang_google_grpc//status",
        "@org_uber_go_zap//:zap",
    ],
)
