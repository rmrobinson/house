"""
This project contains an API and a series of microservices for managing an IoT-enabled house.
"""

module(
    name = "house",
    version = "1.0.0",
)

bazel_dep(name = "rules_go", version = "0.60.0")
bazel_dep(name = "gazelle", version = "0.47.0")
bazel_dep(name = "protobuf", version = "31.1")
bazel_dep(name = "rules_proto", version = "7.1.0")
bazel_dep(name = "rules_proto_grpc", version = "5.8.0")
bazel_dep(name = "rules_proto_grpc_go", version = "5.8.0")
bazel_dep(name = "platforms", version = "1.0.0")

# Provides google/rpc/status.proto, used by api/bridge.proto's CommandUpdate
# to report asynchronous command outcomes. Only the proto_library side is used
# here (@googleapis//google/rpc:status_proto) — the generated Go code links
# against the google.golang.org/genproto/googleapis/rpc/status package already
# pulled in transitively via go.mod/grpc (see use_repo below), since linking
# both googleapis's own go_proto_library and the go.mod copy of the same
# import path conflicts at link time.
bazel_dep(name = "googleapis", version = "0.0.0-20260825-d10ac924")

# Deploy tooling: cross-compilation (incl. CGO, e.g. bridges/airthings) and
# OCI image build/push for house-config's docker-compose deploys. See
# images/README.md.
bazel_dep(name = "hermetic_cc_toolchain", version = "4.3.0")
bazel_dep(name = "rules_oci", version = "2.3.0")
bazel_dep(name = "rules_pkg", version = "1.3.0")

go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(version = "1.26.4")

go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")

# esphome-apiclient ships its api.proto/api_options.proto sources alongside pre-generated .pb.go
# files checked into pb/ (built via `go generate`, not Bazel). Gazelle's default proto handling
# would otherwise regenerate a competing go_proto_library from those .proto files at the module
# root, whose symbols collide with the already-compiled pb/ package. Disable proto handling for
# this repo so gazelle just treats it as plain Go sources.
go_deps.gazelle_override(
    directives = ["gazelle:proto disable_global"],
    path = "github.com/richard87/esphome-apiclient",
)
use_repo(
    go_deps,
    "com_github_davecgh_go_spew",
    "com_github_eclipse_paho_mqtt_golang",
    "com_github_golang_migrate_migrate_v4",
    "com_github_google_uuid",
    "com_github_gorilla_websocket",
    "com_github_grandcat_zeroconf",
    "com_github_hashicorp_mdns",
    "com_github_hekmon_plexwebhooks",
    "com_github_koron_go_ssdp",
    "com_github_lukehagar_plexgo",
    "com_github_mctofu_homekit",
    "com_github_mdlayher_apcupsd",
    "com_github_picatz_roku",
    "com_github_rafalop_sevensegment",
    "com_github_richard87_esphome_apiclient",
    "com_github_rmrobinson_airthings_btle",
    "com_github_rmrobinson_nanoleaf_go",
    "com_github_rmrobinson_omada",
    "com_github_spf13_cobra",
    "com_github_spf13_viper",
    "com_github_stretchr_testify",
    "in_gopkg_yaml_v3",
    "org_golang_google_genproto_googleapis_rpc",
    "org_golang_google_grpc",
    "org_golang_google_protobuf",
    "org_golang_x_crypto",
    "org_golang_x_sync",
    "org_tinygo_x_bluetooth",
    "org_uber_go_zap",
)

# hermetic, Zig-based C/C++ cross-toolchain — lets CGO bridges (airthings
# today) cross-compile without a hand-maintained sysroot. libc_aware/glibc
# variants chosen to match the glibc-based runtime base images in //images.
# housed used to need this too (CGO via mattn/go-sqlite3), until that turned
# out to only ever have been exercised cross-compiling for arm64 (iot001) -
# h031's first-ever amd64 deploy of housed hit a real CGO_ENABLED=0 stub
# (go-sqlite3 silently becomes a non-functional stub without real cgo).
# Rather than debug the amd64 leg of this same toolchain, housed was moved to
# a pure-Go sqlite driver (modernc.org/sqlite, via golang-migrate's
# database/sqlite package) instead - see service/house/db/database.go.
cc_toolchains = use_extension("@hermetic_cc_toolchain//toolchain:ext.bzl", "toolchains")
use_repo(cc_toolchains, "zig_sdk")

register_toolchains(
    "@zig_sdk//libc_aware/toolchain:linux_amd64_gnu.2.28",
    "@zig_sdk//libc_aware/toolchain:linux_arm64_gnu.2.28",
)

oci = use_extension("@rules_oci//oci:extensions.bzl", "oci")
oci.pull(
    name = "distroless_base",
    image = "gcr.io/distroless/base-debian12",
    # arm64's manifest-list entry carries an OCI "variant: v8" descriptor —
    # plain "linux/arm64" doesn't match it, has to be spelled out.
    platforms = [
        "linux/amd64",
        "linux/arm64/v8",
    ],
    reproducible = False,  # home-lab use; pin a digest instead if this needs to be reproducible
    tag = "latest",
)

# airthings needs libdbus at runtime (tinygo BLE -> cbgo -> BlueZ over D-Bus),
# which distroless/base doesn't carry.
oci.pull(
    name = "debian_slim",
    image = "docker.io/library/debian",
    platforms = [
        "linux/amd64",
        "linux/arm64/v8",
    ],
    reproducible = False,
    tag = "trixie-slim",
)
use_repo(
    oci,
    "debian_slim",
    "debian_slim_linux_amd64",
    "debian_slim_linux_arm64_v8",
    "distroless_base",
    "distroless_base_linux_amd64",
    "distroless_base_linux_arm64_v8",
)
