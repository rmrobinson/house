# OCI images for house-config's docker-compose deploys. See README.md.
#
# Not gazelle-managed (no .go files here) — bridge_image() calls are added and
# maintained by hand as bridges get onboarded to deployment. Which host runs
# which of these images is a deployment decision that lives entirely in
# house-config's docker-compose files, not here.

load(":defs.bzl", "bridge_image")

bridge_image(
    name = "plex",
    binary = "//bridges/plex",
)

bridge_image(
    name = "webos",
    binary = "//bridges/webos",
)

bridge_image(
    name = "cast",
    binary = "//bridges/cast",
)

bridge_image(
    name = "frigate",
    binary = "//bridges/frigate",
)

bridge_image(
    name = "omada",
    binary = "//bridges/omada",
)

bridge_image(
    name = "ecobee",
    binary = "//bridges/ecobee",
)

bridge_image(
    name = "housed",
    binary = "//service/house/cmd/housed",
)

bridge_image(
    # Must match the go_binary's own name (bridgefacaded, not "facade") -
    # defs.bzl derives the container entrypoint from this name, and the
    # actual binary in the layer is named after the go_binary target, not
    # this macro call.
    name = "bridgefacaded",
    binary = "//service/bridge/facade/cmd/bridgefacaded",
)

bridge_image(
    name = "esphome",
    binary = "//bridges/esphome",
)

# tinygo BLE -> cbgo -> BlueZ over D-Bus needs libdbus at runtime, which
# distroless/base doesn't carry.
bridge_image(
    name = "airthings",
    base = "@debian_slim",
    binary = "//bridges/airthings",
)

bridge_image(
    name = "tesla-charger",
    binary = "//bridges/tesla-charger",
)

bridge_image(
    name = "zwave",
    binary = "//bridges/zwave",
)

bridge_image(
    name = "zigbee",
    binary = "//bridges/zigbee",
)

bridge_image(
    name = "apc-ups",
    binary = "//bridges/apc-ups",
)
