# OCI images for house-config's docker-compose deploys. See README.md.
#
# Not gazelle-managed (no .go files here) — bridge_image() calls are added and
# maintained by hand as bridges get onboarded to deployment.

load(":defs.bzl", "bridge_image")

# --- h031 ---
bridge_image(name = "plex", binary = "//bridges/plex")
bridge_image(name = "webos", binary = "//bridges/webos")
bridge_image(name = "cast", binary = "//bridges/cast")
bridge_image(name = "frigate", binary = "//bridges/frigate")
bridge_image(name = "omada", binary = "//bridges/omada")
bridge_image(name = "ecobee", binary = "//bridges/ecobee")
bridge_image(name = "housed", binary = "//service/house/cmd/housed")

# --- iot001 ---
bridge_image(name = "esphome", binary = "//bridges/esphome")

# tinygo BLE -> cbgo -> BlueZ over D-Bus needs libdbus at runtime, which
# distroless/base doesn't carry.
bridge_image(name = "airthings", binary = "//bridges/airthings", base = "@debian_slim")

bridge_image(name = "tesla-charger", binary = "//bridges/tesla-charger")

# --- both hosts (separate instances, one image) ---
bridge_image(name = "apc-ups", binary = "//bridges/apc-ups")

