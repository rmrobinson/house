# Target platforms for deploy images (see //images). Not managed by gazelle.

platform(
    name = "linux_amd64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    visibility = ["//visibility:public"],
)

platform(
    name = "linux_arm64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:aarch64",
    ],
    visibility = ["//visibility:public"],
)

# Raspberry Pi 1 (ARMv6, VFPv2). rules_go derives GOARM=6 from the arm:6 constraint.
platform(
    name = "linux_arm6",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:armv7",  # rules_go's GOARCH=arm; GOARM comes from arm:6
        "@rules_go//go/constraints/arm:6",
    ],
    visibility = ["//visibility:public"],
)
